extends Node
## Background music: the lobby theme in the menus, a calmer piece on the match
## over / map vote screen, silence while playing (footsteps and shots matter).
## The pieces are generated by tools/music/make_music.gd and loop on import.
##
## Two players crossfade between pieces. Their level follows
## Config.music_volume live (under the master volume, like every sound).

const TRACKS := {
	"menu": "res://audio/music/menu_winter.wav",
	"results": "res://audio/music/results_winter.wav",
}
## Music sits a little under the game sounds.
const LEVEL_DB := -7.0

var _players: Array[AudioStreamPlayer] = []
## Fade level (0..1) of each player.
var _gain := [0.0, 0.0]
var _tweens: Array[Tween] = [null, null]
var _active := 0
var _current := ""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in 2:
		var p := AudioStreamPlayer.new()
		p.bus = &"Master"
		add_child(p)
		_players.append(p)


## Plays a piece by name (see TRACKS), crossfading from the current one.
## Asking for the piece that is already playing does nothing.
func play(track: String, fade := 1.2) -> void:
	if track == _current or not TRACKS.has(track):
		return
	var stream := load(TRACKS[track]) as AudioStream
	if stream == null:
		return
	_current = track
	_fade(_active, 0.0, fade, true)
	_active = 1 - _active
	var p := _players[_active]
	p.stream = stream
	_gain[_active] = 0.0
	_apply_volume()
	p.play()
	_fade(_active, 1.0, fade, false)


## Fades the music out.
func stop(fade := 1.5) -> void:
	if _current == "":
		return
	_current = ""
	_fade(_active, 0.0, fade, true)


func _fade(index: int, to: float, seconds: float, stop_after: bool) -> void:
	if _tweens[index] and _tweens[index].is_valid():
		_tweens[index].kill()
	var t := create_tween()
	t.tween_method(func(v: float): _gain[index] = v, float(_gain[index]), to, maxf(seconds, 0.01))
	if stop_after:
		t.tween_callback(_players[index].stop)
	_tweens[index] = t


func _process(_delta: float) -> void:
	_apply_volume()


func _apply_volume() -> void:
	for i in 2:
		var level := float(_gain[i]) * Config.music_volume
		_players[i].volume_db = linear_to_db(maxf(level, 0.0001)) + LEVEL_DB
