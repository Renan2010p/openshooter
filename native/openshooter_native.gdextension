[configuration]

entry_symbol = "openshooter_native_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "bin/libopenshooter_native.so"
linux.release.x86_64 = "bin/libopenshooter_native.so"
freebsd.debug.x86_64 = "bin/libopenshooter_native.freebsd.so"
freebsd.release.x86_64 = "bin/libopenshooter_native.freebsd.so"
windows.debug.x86_64 = "bin/openshooter_native.dll"
windows.release.x86_64 = "bin/openshooter_native.dll"
macos.debug = "bin/libopenshooter_native.macos.dylib"
macos.release = "bin/libopenshooter_native.macos.dylib"
android.debug.arm64 = "bin/libopenshooter_native.android.so"
android.release.arm64 = "bin/libopenshooter_native.android.so"
android.debug.arm32 = "bin/libopenshooter_native.android-arm32.so"
android.release.arm32 = "bin/libopenshooter_native.android-arm32.so"
