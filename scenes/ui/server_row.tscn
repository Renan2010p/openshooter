[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/server_row.gd" id="1_row"]
[ext_resource type="FontFile" path="res://assets/fonts/BarlowCondensed-Bold.ttf" id="2_cond"]
[ext_resource type="FontFile" path="res://assets/fonts/BarlowCondensed-ExtraBoldItalic.ttf" id="3_xbold"]
[ext_resource type="FontFile" path="res://assets/fonts/Barlow-Bold.ttf" id="4_bold"]

[sub_resource type="StyleBoxFlat" id="RowStyle"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
bg_color = Color(1, 1, 1, 0.045)
border_width_left = 4
border_color = Color(1, 0.541, 0.122, 1)

[node name="ServerRow" type="PanelContainer"]
theme_override_styles/panel = SubResource("RowStyle")
script = ExtResource("1_row")

[node name="Content" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Thumb" type="TextureRect" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(112, 60)
layout_mode = 2
expand_mode = 1
stretch_mode = 6

[node name="Info" type="VBoxContainer" parent="Content"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 2

[node name="ServerName" type="Label" parent="Content/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("2_cond")
theme_override_font_sizes/font_size = 22
text = "Server"
text_overrun_behavior = 3

[node name="Details" type="Label" parent="Content/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Map · 192.168.0.10"

[node name="Players" type="VBoxContainer" parent="Content"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="Count" type="Label" parent="Content/Players"]
unique_name_in_owner = true
layout_mode = 2
theme_override_fonts/font = ExtResource("3_xbold")
theme_override_font_sizes/font_size = 22
text = "0 / 0"
horizontal_alignment = 2

[node name="Bots" type="Label" parent="Content/Players"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Caption"
text = "NO BOTS"
horizontal_alignment = 2

[node name="Join" type="Button" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 46)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "JOIN"
