theme_override_font_sizes/font_size = 12
text = "M A T C H   I N   P R O G R E S S"

[node name="Title" type="Label" parent="Side/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/line_spacing = -10
theme_override_fonts/font = ExtResource("2_black")
theme_override_font_sizes/font_size = 72
text = "PAUSED"

[node name="Subtitle" type="Label" parent="Side/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.659, 0.686, 0.733, 1)
theme_override_font_sizes/font_size = 13
