[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/modes_screen.gd" id="1_modes"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/back.svg" id="2_back"]
[ext_resource type="Texture2D" path="res://assets/ui/icons/code.svg" id="3_code"]

[node name="Modes" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1_modes")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 56.0
offset_top = 48.0
offset_right = -56.0
offset_bottom = -56.0
theme_override_constants/separation = 0

[node name="Eyebrow" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "PLAY"

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Titles" type="VBoxContainer" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Content/Header/Titles"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "SELECT MODE"

[node name="Subtitle" type="Label" parent="Content/Header/Titles"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Pick the game mode and map for the servers you create. Players can vote for another mode after each match."

[node name="Back" type="Button" parent="Content/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 44)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"GhostButton"
text = "Back"
icon = ExtResource("2_back")

[node name="Gap" type="Control" parent="Content"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="Body" type="HBoxContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="Cards" type="GridContainer" parent="Content/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
columns = 2

[node name="Side" type="PanelContainer" parent="Content/Body"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
theme_type_variation = &"Card"

[node name="Rows" type="VBoxContainer" parent="Content/Body/Side"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="MapCaption" type="Label" parent="Content/Body/Side/Rows"]
layout_mode = 2
theme_type_variation = &"Caption"
text = "MAP"

[node name="Map" type="OptionButton" parent="Content/Body/Side/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
focus_mode = 0

[node name="MapDescription" type="Label" parent="Content/Body/Side/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_type_variation = &"HintLabel"
autowrap_mode = 2

[node name="Spacer" type="Control" parent="Content/Body/Side/Rows"]
layout_mode = 2
size_flags_vertical = 3

[node name="Private" type="Button" parent="Content/Body/Side/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"MenuBtn"
text = "Private match (code)"
icon = ExtResource("3_code")

[node name="Confirm" type="Button" parent="Content/Body/Side/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"PrimaryButton"
text = "CONFIRM"
